{
  "name": "khan-md",
  "version": "15.0.0",
  "private": true,
  "type": "module",
  "description": "A small, command-driven WhatsApp bot built with Baileys",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:pm2": "pm2 start index.js --name KHAN-MD",
    "stop": "pm2 stop KHAN-MD",
    "restart": "pm2 restart KHAN-MD",
    "check": "node --check index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "pino": "^9.7.0",
    "pm2": "^6.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
