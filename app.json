{
  "name": "KHAN-MD",
  "description": "A small command-driven WhatsApp bot built with Baileys",
  "logo": "https://files.catbox.moe/6zd0ru.jpg",
  "keywords": [
    "KHAN-MD",
    "WhatsApp",
    "Baileys"
  ],
  "success_url": "/",
  "stack": "container",
  "env": {
    "PHONE_NUMBER": {
      "description": "WhatsApp number to request a pairing code for, with country code and digits only. Needed for first-time linking.",
      "required": false,
      "value": ""
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "required": false,
      "value": "."
    },
    "PORT": {
      "description": "Health server port",
      "required": false,
      "value": "9090"
    },
    "LOG_LEVEL": {
      "description": "Baileys log level",
      "required": false,
      "value": "warn"
    }
  }
}
